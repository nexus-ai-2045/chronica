# Chronica bot 用環境変数テンプレート。
# 実際の値を書いたら .env にコピーする (.env は commit 禁止)。

# Discord Developer Portal で発行した Bot token
DISCORD_BOT_TOKEN=

# 収集対象 guild ID (カンマ区切り)。allowlist 外の guild のイベントは無視する。
GUILD_ALLOWLIST=

# SQLite DB の出力先
CHRONICA_DB=../data/chronica.db

# chronica-data.js の出力先
EXPORT_OUT=../data/chronica-data.js
